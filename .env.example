# API keys for the Gradio app's downstream LLM tutor integration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# x.AI (Grok) — used for the AI tutor response layer
XAI_API_KEY=PASTE_YOUR_XAI_API_KEY_HERE

# Optional: alternative LLM providers (not currently used, but reserved)
# OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
# ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE